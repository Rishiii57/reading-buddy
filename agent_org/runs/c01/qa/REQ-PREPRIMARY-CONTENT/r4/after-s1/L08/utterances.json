 "buddy_said": [
  {
   "t": 12.71,
   "type": "say",
   "kind": "intro",
   "text": "नमस्ते! रीडिंग बडी में तुम्हारा स्वागत है! आज हम पढ़ेंगे एक दो तीन चार ध्यान से सुनो, मैं कैसे पढ़ता हूँ। एक दो तीन चार अब तुम्हारी बारी। मेरे साथ पढ़ो!",
   "spans": [
    [
     0,
     4
    ]
   ]
  },
  {
   "t": 43.48,
   "type": "say",
   "kind": "echo_line",
   "text": "भैया बनो होशियार। अब तुम बोलो!",
   "spans": [
