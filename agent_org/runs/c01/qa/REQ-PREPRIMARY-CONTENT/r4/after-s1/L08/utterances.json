  },
  {
   "t": 60.68,
   "type": "say",
   "kind": "praise",
   "text": "बहुत अच्छे! पढ़ते रहो।",
   "spans": []
  },
  {
   "t": 60.68,
   "type": "say",
   "kind": "echo_line",
   "text": "पाँच छह सात आठ अब तुम बोलो!",
