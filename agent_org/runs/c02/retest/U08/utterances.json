   ]
  },
  {
   "t": 62.91,
   "type": "say",
   "kind": "praise",
   "text": "बहुत अच्छे! पढ़ते रहो।",
   "spans": []
  },
  {
   "t": 62.91,
   "type": "say",
   "kind": "echo_line",
   "text": "हाथ लगाओ डर जाएगी अब तुम बोलो!",
