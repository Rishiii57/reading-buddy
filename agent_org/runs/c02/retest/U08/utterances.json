 "buddy_said": [
  {
   "t": 14.3,
   "type": "say",
   "kind": "intro",
   "text": "नमस्ते! रीडिंग बडी में तुम्हारा स्वागत है! आज हम पढ़ेंगे मछली जल की रानी है ध्यान से सुनो, मैं कैसे पढ़ता हूँ। मछली जल की रानी है अब तुम्हारी बारी। मेरे साथ पढ़ो!",
   "spans": [
    [
     0,
     5
    ]
   ]
  },
  {
   "t": 43.56,
   "type": "say",
   "kind": "uncertain",
   "text": "मैं ठीक से सुन नहीं पाया। क्या तुम फिर से पढ़ोगे?",
   "spans": []
  },
  {
   "t": 49.12,
   "type": "say",
   "kind": "echo_line",
   "text": "जीवन उसका पानी है। अब तुम बोलो!",
