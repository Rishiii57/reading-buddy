[
  {
    "id": "gu-patang",
    "language": "gu-IN",
    "title": "મારો પતંગ",
    "title_en": "My Kite",
    "type": "poem",
    "grade": "1",
    "stanzas": [
      [
        "મારો પતંગ લાલ ને પીળો,",
        "આકાશે ઊડે રંગીલો."
      ],
      [
        "પવન સાથે નાચે ગાય,",
        "ઊંચે ઊંચે ઊડતો જાય."
      ]
    ]
  },
  {
    "id": "gu-varsad",
    "language": "gu-IN",
    "title": "વરસાદ",
    "title_en": "Rain",
    "type": "poem",
    "grade": "1-2",
    "stanzas": [
      [
        "ટપ ટપ ટપ ટપ વરસાદ પડે,",
        "દેડકા મીઠું ગીત બોલે."
      ],
      [
        "છોકરાં પાણીમાં રમે,",
        "કાગળની હોડી ડોલે."
      ]
    ]
  },
  {
    "id": "gu-chakli",
    "language": "gu-IN",
    "title": "ચકલી અને દાણા",
    "title_en": "The Sparrow and the Grains",
    "type": "passage",
    "grade": "2-3",
    "stanzas": [
      [
        "એક નાની ચકલી હતી.",
        "તે રોજ સવારે દાણા શોધવા જતી."
      ],
      [
        "એક દિવસ તેને ઘણા બધા દાણા મળ્યા.",
        "ચકલીએ તે દાણા તેના બચ્ચાંને ખવડાવ્યા."
      ]
    ]
  },
  {
    "id": "gu-shala",
    "language": "gu-IN",
    "title": "મારી શાળા",
    "title_en": "My School",
    "type": "passage",
    "grade": "3-4",
    "stanzas": [
      [
        "મારી શાળા બહુ સુંદર છે.",
        "શાળામાં એક મોટું મેદાન છે."
      ],
      [
        "અમે ત્યાં રોજ સાથે રમીએ છીએ.",
        "મારા શિક્ષક અમને વાર્તા કહે છે."
      ]
    ]
  },
  {
    "id": "gu-mamanughar",
    "language": "gu-IN",
    "title": "મામાનું ઘર કેટલે",
    "title_en": "How Far Is Uncle's House",
    "type": "poem",
    "grade": "Nursery",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "મામાનું ઘર કેટલે,",
        "દીવો બળે એટલે."
      ],
      [
        "દીવો મેં તો દીઠો,",
        "મામો લાગે મીઠો."
      ]
    ]
  },
  {
    "id": "gu-avre",
    "language": "gu-IN",
    "title": "આવ રે વરસાદ",
    "title_en": "Come, Rain",
    "type": "poem",
    "grade": "LKG",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "આવ રે વરસાદ,",
        "ઘેવરિયો પરસાદ."
      ],
      [
        "ઊની ઊની રોટલી,",
        "ને કારેલાનું શાક."
      ]
    ]
  },
  {
    "id": "gu-biladi",
    "language": "gu-IN",
    "title": "એક બિલાડી જાડી",
    "title_en": "A Fat Cat",
    "type": "poem",
    "grade": "LKG",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "એક બિલાડી જાડી,",
        "તેણે પહેરી સાડી."
      ],
      [
        "સાડી પહેરી ફરવા ગઈ,",
        "તળાવમાં તે તરવા ગઈ."
      ]
    ]
  },
  {
    "id": "gu-varta",
    "language": "gu-IN",
    "title": "વારતા રે વારતા",
    "title_en": "A Story, a Story",
    "type": "poem",
    "grade": "UKG",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "વારતા રે વારતા,",
        "ભાભા ઢોર ચારતા."
      ],
      [
        "ચપટી બોર લાવતા,",
        "છોકરાંવને સમજાવતા."
      ]
    ]
  }
]
