[
  {
    "id": "gu-patang",
    "language": "gu-IN",
    "title": "મારો પતંગ",
    "title_en": "My Kite",
    "type": "poem",
    "grade": "1",
    "stanzas": [
      ["મારો પતંગ લાલ ને પીળો,", "આકાશે ઊડે રંગીલો."],
      ["પવન સાથે નાચે ગાય,", "ઊંચે ઊંચે ઊડતો જાય."]
    ]
  },
  {
    "id": "gu-varsad",
    "language": "gu-IN",
    "title": "વરસાદ",
    "title_en": "Rain",
    "type": "poem",
    "grade": "1-2",
    "stanzas": [
      ["ટપ ટપ ટપ ટપ વરસાદ પડે,", "દેડકા મીઠું ગીત બોલે."],
      ["છોકરાં પાણીમાં રમે,", "કાગળની હોડી ડોલે."]
    ]
  },
  {
    "id": "gu-chakli",
    "language": "gu-IN",
    "title": "ચકલી અને દાણા",
    "title_en": "The Sparrow and the Grains",
    "type": "passage",
    "grade": "2-3",
    "stanzas": [
      ["એક નાની ચકલી હતી.", "તે રોજ સવારે દાણા શોધવા જતી."],
      ["એક દિવસ તેને ઘણા બધા દાણા મળ્યા.", "ચકલીએ તે દાણા તેના બચ્ચાંને ખવડાવ્યા."]
    ]
  },
  {
    "id": "gu-shala",
    "language": "gu-IN",
    "title": "મારી શાળા",
    "title_en": "My School",
    "type": "passage",
    "grade": "3-4",
    "stanzas": [
      ["મારી શાળા બહુ સુંદર છે.", "શાળામાં એક મોટું મેદાન છે."],
      ["અમે ત્યાં રોજ સાથે રમીએ છીએ.", "મારા શિક્ષક અમને વાર્તા કહે છે."]
    ]
  }
]
