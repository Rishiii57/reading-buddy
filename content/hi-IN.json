[
  {
    "id": "hi-gudiya",
    "language": "hi-IN",
    "title": "मेरी गुड़िया",
    "title_en": "My Doll",
    "type": "poem",
    "grade": "1",
    "stanzas": [
      [
        "मेरी गुड़िया प्यारी है,",
        "सबसे न्यारी न्यारी है।"
      ],
      [
        "लाल चुनरी ओढ़ के आती,",
        "मीठे मीठे गाने गाती।"
      ]
    ]
  },
  {
    "id": "hi-baarish",
    "language": "hi-IN",
    "title": "बारिश आई",
    "title_en": "The Rain Came",
    "type": "poem",
    "grade": "1-2",
    "stanzas": [
      [
        "बादल गरजे, बारिश आई,",
        "ठंडी ठंडी हवा भी आई।"
      ],
      [
        "मेंढक गाते मीठे गाने,",
        "बच्चे निकले नाव चलाने।"
      ]
    ]
  },
  {
    "id": "hi-chidiya",
    "language": "hi-IN",
    "title": "चिड़िया का घोंसला",
    "title_en": "The Sparrow's Nest",
    "type": "passage",
    "grade": "2-3",
    "stanzas": [
      [
        "एक पेड़ पर एक छोटी चिड़िया रहती थी।",
        "उसने तिनकों से एक सुंदर घोंसला बनाया।"
      ],
      [
        "घोंसले में तीन छोटे अंडे थे।",
        "चिड़िया रोज़ अपने बच्चों के लिए दाना लाती थी।"
      ]
    ]
  },
  {
    "id": "hi-bagicha",
    "language": "hi-IN",
    "title": "मीना का बगीचा",
    "title_en": "Meena's Garden",
    "type": "passage",
    "grade": "3-4",
    "stanzas": [
      [
        "मीना के घर के पीछे एक बगीचा है।",
        "उसमें लाल और पीले फूल खिलते हैं।"
      ],
      [
        "मीना हर सुबह पौधों को पानी देती है।",
        "उसे अपने बगीचे से बहुत प्यार है।"
      ]
    ]
  },
  {
    "id": "hi-machhli",
    "language": "hi-IN",
    "title": "मछली जल की रानी है",
    "title_en": "The Fish Is the Queen of Water",
    "type": "poem",
    "grade": "Nursery",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "मछली जल की रानी है,",
        "जीवन उसका पानी है।"
      ],
      [
        "हाथ लगाओ डर जाएगी,",
        "बाहर निकालो मर जाएगी।"
      ]
    ]
  },
  {
    "id": "hi-samandar",
    "language": "hi-IN",
    "title": "हरा समंदर",
    "title_en": "Green Sea",
    "type": "poem",
    "grade": "Nursery",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "हरा समंदर, गोपी चंदर,",
        "बोल मेरी मछली कितना पानी?"
      ]
    ]
  },
  {
    "id": "hi-aloo",
    "language": "hi-IN",
    "title": "आलू कचालू",
    "title_en": "Aloo Kachaloo",
    "type": "poem",
    "grade": "LKG",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "आलू कचालू बेटा कहाँ गए थे,",
        "बैंगन की टोकरी में सो रहे थे।"
      ],
      [
        "बैंगन ने लात मारी रो रहे थे,",
        "मम्मी ने प्यार किया हँस रहे थे।"
      ]
    ]
  },
  {
    "id": "hi-ekdo",
    "language": "hi-IN",
    "title": "एक दो तीन चार",
    "title_en": "One Two Three Four",
    "type": "poem",
    "grade": "UKG",
    "source": "traditional rhyme (public domain); text to be checked by a native-speaking teacher",
    "stanzas": [
      [
        "एक दो तीन चार,",
        "भैया बनो होशियार।"
      ],
      [
        "पाँच छह सात आठ,",
        "पढ़ो रोज़ तुम पाठ।"
      ]
    ]
  }
]
