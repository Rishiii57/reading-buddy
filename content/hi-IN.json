[
  {
    "id": "hi-gudiya",
    "language": "hi-IN",
    "title": "मेरी गुड़िया",
    "title_en": "My Doll",
    "type": "poem",
    "grade": "1",
    "stanzas": [
      ["मेरी गुड़िया प्यारी है,", "सबसे न्यारी न्यारी है।"],
      ["लाल चुनरी ओढ़ के आती,", "मीठे मीठे गाने गाती।"]
    ]
  },
  {
    "id": "hi-baarish",
    "language": "hi-IN",
    "title": "बारिश आई",
    "title_en": "The Rain Came",
    "type": "poem",
    "grade": "1-2",
    "stanzas": [
      ["बादल गरजे, बारिश आई,", "ठंडी ठंडी हवा भी आई।"],
      ["मेंढक गाते मीठे गाने,", "बच्चे निकले नाव चलाने।"]
    ]
  },
  {
    "id": "hi-chidiya",
    "language": "hi-IN",
    "title": "चिड़िया का घोंसला",
    "title_en": "The Sparrow's Nest",
    "type": "passage",
    "grade": "2-3",
    "stanzas": [
      ["एक पेड़ पर एक छोटी चिड़िया रहती थी।", "उसने तिनकों से एक सुंदर घोंसला बनाया।"],
      ["घोंसले में तीन छोटे अंडे थे।", "चिड़िया रोज़ अपने बच्चों के लिए दाना लाती थी।"]
    ]
  },
  {
    "id": "hi-bagicha",
    "language": "hi-IN",
    "title": "मीना का बगीचा",
    "title_en": "Meena's Garden",
    "type": "passage",
    "grade": "3-4",
    "stanzas": [
      ["मीना के घर के पीछे एक बगीचा है।", "उसमें लाल और पीले फूल खिलते हैं।"],
      ["मीना हर सुबह पौधों को पानी देती है।", "उसे अपने बगीचे से बहुत प्यार है।"]
    ]
  }
]
